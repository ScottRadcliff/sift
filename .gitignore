*.swp
*.swo
*~
.DS_Store
._*
Thumbs.db
Desktop.ini

# Local scratch files; keep sample files and expected QA output trackable
/tmp/
/scratch/
*.log

# Python bytecode cache
__pycache__/
*.pyc
